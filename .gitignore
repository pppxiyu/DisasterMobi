# .gitignore
# Tracks only source: config.py, run_*.py, tune_*.py, utils/, README.md.
# Everything below is ignored. NOTE: comments must be on their own line —
# git treats a '#' that is not at line-start as part of the pattern.

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ── Caches / generated artifacts (regenerated; not source) ────────────────────
# .cache/ is the single cache root: .cache/model (NN checkpoints) and
# .cache/optuna/<task>/<task>.db (all Optuna fine-tuning studies — NMF + GRU).
.cache/
files/

# ── Data / outputs / docs / notebooks / archive (not source) ──────────────────
# docs/ is ignored per-entry (docs/*) rather than as a directory, because git
# never descends into an excluded directory — a whole-dir docs/ ignore would
# make the technical_notes exemption below dead.
data/
outputs/
docs/*
!docs/technical_notes/
notebook_drafts/
# Retired exploration scripts (see archive/README.md) — kept on disk, not tracked.
archive/

# ── Tuning / verification scratch logs (the tuner SCRIPTS are kept; the study
#    dbs live under .cache/optuna/, already ignored above) ──────────────────────
_tune_run*.log
_verify_*.log

# ── Task / review scratch docs (not source) ───────────────────────────────────
TASK.md

# ── Editor / tooling / OS / misc auxiliary folders ────────────────────────────
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
