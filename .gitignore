# .gitignore
# Tracks only source: config.py, run_*.py, utils_*/.
# Everything below is ignored. NOTE: comments must be on their own line —
# git treats a '#' that is not at line-start as part of the pattern.

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ── Caches / generated artifacts (regenerated; not source) ────────────────────
# .cache/ is the single cache root: .cache/model (NN checkpoints) and
# .cache/optuna/<task>/<task>.db (all Optuna fine-tuning studies — NMF + GRU).
.cache/
files/

# ── Data / outputs / docs / notebooks (large or auxiliary; not source) ────────
data/
outputs/
# Ignore docs/ EXCEPT the technical notes, which are tracked source.
docs/*
!docs/technical_notes/
notebook_drafts/

# ── Tuning / verification scratch logs (the tuner SCRIPTS are kept; the study
#    dbs live under .cache/optuna/, already ignored above) ──────────────────────
_tune_run*.log
_verify_*.log

# ── Task / review scratch docs (not source) ───────────────────────────────────
TASK.md

# ── Editor / tooling / OS / misc auxiliary folders ────────────────────────────
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
